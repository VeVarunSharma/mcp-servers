{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "org.example/express-mcp-weather",
  "title": "Express MCP Weather Server",
  "description": "MCP server providing weather forecast and alert tools via the National Weather Service API. Built with TypeScript and Express.js.",
  "repository": {
    "url": "https://github.com/your-org/mcp-servers",
    "source": "github"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@your-org/express-mcp-weather",
      "version": "1.0.0",
      "transport": {
        "type": "http"
      },
      "environmentVariables": [
        {
          "name": "PORT",
          "description": "Port for the HTTP server (default: 3000)",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
